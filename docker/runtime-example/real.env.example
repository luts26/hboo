# Copy this file to ~/hboo-runtime/real.env and edit it there.
# Do not put real credentials in this repository.

REAL_HTTP_HOST=127.0.0.1
REAL_HTTP_PORT=80
REAL_HTTPS_HOST=127.0.0.1
REAL_HTTPS_PORT=443
REAL_BACKEND_HOST=127.0.0.1
REAL_BACKEND_PORT=3000

REAL_DB_HOST=host.docker.internal
REAL_DB_PORT=3306
REAL_DB_NAME=change_me_real_database_name
REAL_DB_USER=change_me_real_user
REAL_DB_PASSWORD=change_me_real_password

REAL_BANK_SERVICE_URL=http://host.docker.internal:55441
REAL_BANK_SERVICE_USER=change_me_real_bank_user
REAL_BANK_SERVICE_PASSWORD=change_me_real_bank_password

