# DEV-only local placeholders. Do not use these values in production.
# compose.yaml always uses the DEV database name hboo_dev and ignores DB_NAME.
DB_USER=hboo_dev
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

DEV_HTTP_HOST=127.0.0.2
DEV_HTTP_PORT=80
DEV_HTTPS_HOST=127.0.0.2
DEV_HTTPS_PORT=443
DEV_BACKEND_HOST=127.0.0.2
DEV_BACKEND_PORT=3000
DEV_MYSQL_HOST=127.0.0.2
DEV_MYSQL_PORT=3307

# Synthetic DEV bank-service endpoint only, if one is created later.
DEV_BANK_SERVICE_URL=
DEV_BANK_SERVICE_USER=change_me
DEV_BANK_SERVICE_PASSWORD=change_me
